# sh initialisation here
load std

user = `{cat /dev/user}
home = /usr/^$user
bind -c '#U*'^$emuwdir /n/local
bind -a '#U*'/home /usr
cd /n/local
# build any namespace in cwd /n/local
and {ftest -e namespace}	{nsbuild}
#cd $home
font=/fonts/pelm/unicode.8.font

# build any namespace in $home
and {ftest -e $home/namespace}	{nsbuild $home/namespace}

# Run the $home/lib/profile
and {ftest -e $home/lib/profile} {run $home/lib/profile}
